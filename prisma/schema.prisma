generator client {
  provider = "prisma-client-js"
  
}

model Keepalive {
  id     BigInt   @id @default(autoincrement())
  ranAt  DateTime @default(now())
  source String

  @@map("keepalive")
}


datasource db {
  provider  = "postgresql"
}

model qrcodes {
  id        String    @id @default(uuid())
  userId    String?
  label     String?
  category  String    @default("personal")
  targetUrl String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  user      User?     @relation(fields: [userId], references: [id])
  isPublic  Boolean   @default(false)  
  @@unique([userId, targetUrl])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  avatarUrl           String?   // Cloudinary URL
  avatarUploadCount   Int       @default(0)
  avatarPublicId String?
  lastAvatarUpdatedAt DateTime? // rate limiting
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  qrcodes       qrcodes[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
