generator client {
  provider = "prisma-client-js"
  
}

model Keepalive {
  id     BigInt   @id @default(autoincrement())
  ranAt  DateTime @default(now())
  source String

  @@map("keepalive")
}


datasource db {
  provider  = "postgresql"
}

model qrcodes {
  id        String    @id @default(uuid())
  userId    String?
  label     String?
  category  String    @default("personal")
  targetUrl String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  user      User?     @relation(fields: [userId], references: [id])
  isPublic  Boolean   @default(false)  
  @@unique([userId, targetUrl])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  avatarUrl           String?   // Cloudinary URL
  avatarUploadCount   Int       @default(0)
  avatarPublicId String?
  lastAvatarUpdatedAt DateTime? // rate limiting
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  qrcodes       qrcodes[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ReviewLink {
  id            String              @id @default(uuid())
  slug          String              @unique
  businessName  String?
  notifyEmail   String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  destinations  ReviewDestination[]
  submissions   ReviewSubmission[]
}

model ReviewDestination {
  id            String      @id @default(uuid())
  reviewLinkId  String
  platformKey   String
  label         String
  reviewUrl     String
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)

  reviewLink    ReviewLink  @relation(fields: [reviewLinkId], references: [id], onDelete: Cascade)

  @@index([reviewLinkId, sortOrder])
  @@unique([reviewLinkId, platformKey])
}

model ReviewSubmission {
  id           String      @id @default(uuid())
  reviewLinkId String
  rating       Int
  message      String?
  userAgent    String?
  ipHash       String?
  createdAt    DateTime    @default(now())

  reviewLink   ReviewLink  @relation(fields: [reviewLinkId], references: [id], onDelete: Cascade)

  @@index([reviewLinkId, createdAt])
}
